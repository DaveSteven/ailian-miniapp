page {
  min-height: 100%;
  background: #f4f6f5;
  color: #18302d;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.intro-card {
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #113f3a, #17685e);
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(17, 63, 58, 0.18);
}

.intro-badge {
  display: inline-block;
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 999rpx;
  color: #c9f7ef;
  font-size: 22rpx;
}

.intro-title {
  margin-top: 20rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.intro-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  line-height: 1.5;
}

.section {
  margin-top: 24rpx;
  padding: 30rpx 28rpx 6rpx;
  border: 1rpx solid #e5ebe8;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(39, 70, 64, 0.045);
}

.section-title {
  margin-bottom: 30rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.required-mark {
  color: #f06c48;
}

.section-help {
  margin: -18rpx 0 24rpx;
  color: #87948f;
  font-size: 23rpx;
  line-height: 1.5;
}

.field {
  margin-bottom: 28rpx;
}

.field-row {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.field-half {
  width: 100%;
  min-width: 0;
}

.contact-card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 22rpx 20rpx 0;
  border: 1rpx solid #e1e9e6;
  border-radius: 20rpx;
  background: #f9fbfa;
}

.contact-head {
  margin-bottom: 20rpx;
}

.contact-title {
  color: #29443f;
  font-size: 26rpx;
  font-weight: 700;
}

.contact-title text {
  margin-left: 12rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #dff6f1;
  color: #118f7f;
  font-size: 20rpx;
  font-weight: 500;
}

.compact-field {
  margin-bottom: 22rpx;
}

.remove-contact,
.add-contact {
  margin: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.remove-contact {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #fff0eb;
  color: #b45338;
  font-size: 21rpx;
  line-height: 48rpx;
}

.add-contact {
  width: 100%;
  margin-bottom: 28rpx;
  background: #eaf5f2;
  color: #167d70;
  line-height: 72rpx;
  font-weight: 600;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.image-item,
.image-add {
  position: relative;
  width: 100%;
  height: 190rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(20, 35, 32, 0.72);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1;
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 20rpx 8rpx;
  border: 2rpx dashed #bfd1cc;
  background: #f7faf9;
  color: #56706a;
  font-size: 23rpx;
  line-height: 1.4;
}

.image-add-icon {
  color: #149786;
  font-size: 44rpx;
  line-height: 1;
}

.image-count {
  margin-top: 5rpx;
  color: #94a29f;
  font-size: 20rpx;
}

.field-label {
  margin-bottom: 13rpx;
  color: #415652;
  font-size: 25rpx;
  font-weight: 600;
}

.field-label text {
  color: #f06c48;
}

.field-input,
.picker-value {
  height: 86rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 18rpx;
  background: #f9fbfa;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value text {
  color: #76918b;
  font-size: 38rpx;
}

.placeholder {
  color: #9ba9a6;
}

.field-textarea {
  width: 100%;
  height: 176rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 18rpx;
  background: #f9fbfa;
  font-size: 28rpx;
  box-sizing: border-box;
}

.field-tip {
  margin-top: 10rpx;
  color: #94a29f;
  font-size: 22rpx;
}

.location-card {
  display: flex;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 24rpx;
  border: 2rpx dashed #cbd8d4;
  border-radius: 20rpx;
  background: #f8faf9;
  box-sizing: border-box;
}

.location-card.selected {
  border-style: solid;
  border-color: #72c9ba;
  background: #f0fbf8;
}

.pin {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #dff6f1;
  color: #118f7f;
  font-size: 30rpx;
  font-weight: 700;
}

.location-content {
  flex: 1;
  min-width: 0;
}

.location-name {
  font-size: 28rpx;
  font-weight: 650;
}

.location-address {
  margin-top: 7rpx;
  color: #758580;
  font-size: 23rpx;
  line-height: 1.45;
}

.location-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.location-button {
  flex: 1;
  margin: 0;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.location-button::after,
.submit-button::after,
.remove-contact::after,
.add-contact::after,
.image-add::after {
  border: 0;
}

.location-button.primary {
  background: #18aa98;
  color: #ffffff;
}

.location-button.secondary {
  background: #eaf5f2;
  color: #167d70;
}

.address-field {
  margin-top: 28rpx;
}

.submit-wrap {
  padding: 34rpx 4rpx 0;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  padding: 0;
  border-radius: 22rpx;
  background: #ff7548;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  box-shadow: 0 12rpx 28rpx rgba(255, 117, 72, 0.22);
}

.submit-button[disabled] {
  background: #ff9a78;
  color: rgba(255, 255, 255, 0.9);
  box-shadow: none;
}

.submit-tip {
  margin-top: 18rpx;
  color: #87948f;
  font-size: 22rpx;
  text-align: center;
}
