page { height: 100%; background: #f5f5f5; color: #173c36; }
.login-page { position: relative; height: 100vh; overflow: hidden; }
.home-preview { position: absolute; inset: 0; background: #f5f5f5; }
.preview-header { height: 176rpx; padding: 88rpx 28rpx 20rpx; border-bottom: 1rpx solid #e8e8e8; box-sizing: border-box; }
.preview-menu { width: 68rpx; height: 68rpx; padding: 18rpx 16rpx; display: flex; flex-direction: column; justify-content: space-between; border-radius: 18rpx; background: #fff; box-shadow: 0 5rpx 16rpx rgba(54,78,72,.07); box-sizing: border-box; }
.preview-menu text { height: 4rpx; border-radius: 99rpx; background: #36534d; }
.preview-chat { padding: 46rpx 30rpx; display: flex; flex-direction: column; }
.preview-message { max-width: 590rpx; color: #263238; font-size: 29rpx; line-height: 1.55; }
.preview-message.user { max-width: 540rpx; margin-top: 38rpx; padding: 22rpx 28rpx; align-self: flex-end; border-radius: 30rpx; background: #16b8a6; color: #fff; }
.preview-footer { position: absolute; right: 0; bottom: 0; left: 0; padding: 12rpx 36rpx calc(40rpx + env(safe-area-inset-bottom)); }
.preview-suggestions { display: flex; gap: 24rpx; color: #0b8f80; font-size: 22rpx; white-space: nowrap; }
.preview-composer { height: 84rpx; margin-top: 20rpx; padding: 0 30rpx; display: flex; align-items: center; border: 1rpx solid #eadfd2; border-radius: 42rpx; background: #fff; color: #a1a1a1; font-size: 28rpx; box-shadow: 0 8rpx 24rpx rgba(80,64,48,.045); box-sizing: border-box; }
.login-mask { position: absolute; inset: 0; z-index: 1; background: rgba(18,35,31,.48); backdrop-filter: blur(7rpx); }
.login-card { position: absolute; top: 50%; left: 50%; z-index: 2; width: calc(100% - 96rpx); padding: 44rpx 38rpx 34rpx; border-radius: 34rpx; background: #fff; box-shadow: 0 30rpx 90rpx rgba(9,34,29,.25); transform: translate(-50%,-50%); box-sizing: border-box; }
.brand-mark { width: 76rpx; height: 76rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: linear-gradient(145deg,#123f39,#148878); color: #fff; font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }
.brand-name { margin-top: 16rpx; color: #48605a; text-align: center; font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }
.login-title { margin-top: 34rpx; color: #173c36; text-align: center; font-size: 36rpx; font-weight: 800; line-height: 1.35; }
.login-description { margin-top: 18rpx; color: #71817d; text-align: center; font-size: 25rpx; line-height: 1.65; }
.auth-note { margin-top: 30rpx; padding: 20rpx 22rpx; display: flex; align-items: center; gap: 14rpx; border-radius: 18rpx; background: #f0f8f6; color: #60736e; font-size: 22rpx; line-height: 1.45; }
.auth-note>text { width: 34rpx; height: 34rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #d7eee8; color: #0b8f80; font-size: 20rpx; font-weight: 700; }
.wechat-button { width: 100%; height: 92rpx; margin-top: 30rpx; padding: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 0; border-radius: 24rpx; background: #07c160; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1; box-shadow: 0 14rpx 34rpx rgba(7,193,96,.2); }
.wechat-button::after { border: 0; }
.error-message { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #fff0ec; color: #b54e34; text-align: center; font-size: 22rpx; line-height: 1.5; }
.privacy-tip { margin-top: 20rpx; color: #a1aaa7; text-align: center; font-size: 20rpx; line-height: 1.5; }
